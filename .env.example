# Repo-local mainnet RPC endpoint used at build time for the extension.
# Keep this file as a template only. Put your real value in the repo-root `.env`.
VITE_GRAPE_MAINNET_RPC_URL=https://your-mainnet-rpc.example.com/?api-key=replace-me

# Optional Jupiter API key used for priced asset fetches.
# If omitted, Grape falls back to the public lite-api.jup.ag price endpoint.
VITE_GRAPE_JUP_API_KEY=

# Optional Shyft API key used for token metadata, symbols, and logos.
VITE_GRAPE_SHYFT_API_KEY=
