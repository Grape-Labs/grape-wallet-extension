{
  "manifest_version": 3,
  "name": "Grape Wallet",
  "version": "0.1.0",
  "description": "Chromium-first Solana wallet extension with Wallet Standard and legacy provider support.",
  "icons": {
    "16": "icons/grape-16.png",
    "32": "icons/grape-32.png",
    "48": "icons/grape-48.png",
    "128": "icons/grape-128.png"
  },
  "action": {
    "default_title": "Grape Wallet",
    "default_icon": {
      "16": "icons/grape-16.png",
      "32": "icons/grape-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.mainnet-beta.solana.com/*",
    "https://api.devnet.solana.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content-script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/inpage.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  }
}
