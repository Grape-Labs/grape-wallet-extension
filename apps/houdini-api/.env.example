HOUDINI_API_KEY=
HOUDINI_API_SECRET=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOUDINI_SIGNING_SECRET=
PORT=8788
HOST=127.0.0.1
# Comma-separated exact browser origins. Native mobile requests have no Origin.
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID
# Persist this directory on your server; run one service instance per data directory.
HOUDINI_DATA_DIR=./data
# Set only behind a reverse proxy that overwrites X-Forwarded-For and blocks direct access.
TRUST_PROXY=false
